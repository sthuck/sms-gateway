# Local development defaults — copy to .env (never commit .env)
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Application role (sms_app): subject to RLS, no BYPASSRLS
DATABASE_URL=postgres://sms_app:sms_app@localhost:5432/sms

# Migrator role (table owner / local superuser). Used only by pnpm migrate:*
MIGRATE_DATABASE_URL=postgres://sms:sms@localhost:5432/sms

# Required for migrate:up. Applied only when role sms_app is first created.
# LOCAL-DEV ONLY — never use this value in production; rotate with ALTER ROLE.
SMS_APP_PASSWORD=sms_app

# Placeholder; real encryption key handling is an open item (see docs/architecture.md)
ENCRYPTION_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- OIDC (optional until set; see docs/local-dev.md) ---
# Leave OIDC_ISSUER_URL unset to run the API without login (health only).
# DEV-ONLY Authentik values when using docker-compose.authentik.yml
# (application slug: sms-gateway — same as homelab):
# OIDC_ISSUER_URL=http://127.0.0.1:9000/application/o/sms-gateway/
# OIDC_CLIENT_ID=sms-gateway
# OIDC_CLIENT_SECRET=dev-only-oidc-client-secret
# OIDC_REDIRECT_URI=http://127.0.0.1:8080/v1/auth/callback
# OIDC_SCOPES=openid profile email
# OIDC_CLAIM_EMAIL=email
# OIDC_CLAIM_NAME=name
# OIDC_AUDIENCE=sms-gateway
# OIDC_ALLOWED_ALGS=RS256,ES256
# SESSION_SECRET=dev-only-session-secret-min-32-chars!!
# OIDC_ALLOW_INSECURE=true
# REQUIRE_MFA=true
# MFA_CLAIMS_MISSING=deny
# AUTO_LINK_BY_EMAIL=false
# PUBLIC_BASE_URL=http://127.0.0.1:8080/
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:5173
# SESSION_TTL_SECONDS=604800
#
# Fastify trustProxy for request.ip (rate limits / audit). Default: trust nothing.
# Only the words true/false are booleans. Digits are hop counts (0=none, 1=one hop).
# Prefer an explicit proxy IP/CIDR list. Bare true trusts every hop (unsafe; warns
# in production). Never parse XFF in application code.
# TRUST_PROXY=false
# TRUST_PROXY=10.0.0.0/8
# TRUST_PROXY=1


# --- Device auth / pairing (STH-14; see docs/pairing.md) ---
# Comma-separated Host values accepted in the signed canonical string.
# Include the port when clients send one (emulator: 10.0.2.2:8080).
# DEVICE_ALLOWED_HOSTS=10.0.2.2:8080,127.0.0.1:8080,localhost:8080,api.sms-gateway.example
# Base URL embedded as optional server= in pairing QR payloads:
# DEVICE_API_PUBLIC_URL=http://10.0.2.2:8080
# PAIRING_CODE_TTL_SECONDS=300
# DEVICE_CLOCK_SKEW_SECONDS=300
# DEVICE_REPLAY_TTL_SECONDS=360
# PAIR_RATE_LIMIT_PER_IP=10
# PAIR_RATE_LIMIT_WINDOW_SEC=60
# PAIR_GLOBAL_INVALID_LIMIT=120
# PAIR_GLOBAL_INVALID_WINDOW_SEC=60
# PAIR_IP_INVALID_LOCK_THRESHOLD=20
# PAIR_IP_INVALID_LOCK_SEC=900
#
# Homelab hostnames (deploy deferred; see docs/deployment-auth.md):
#   issuer https://auth.sthuck.info/application/o/sms-gateway/
#   app    https://sms.sthuck.info
