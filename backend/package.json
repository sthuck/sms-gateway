{
  "name": "@sms-gateway/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "mcp": "tsx src/mcp.ts",
    "mcp:start": "node dist/mcp.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check . && pnpm lint:arch && pnpm lint:auth-errors",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:arch": "depcruise --config .dependency-cruiser.cjs --output-type err src/domain src/application src/ports src/adapters src/composition",
    "lint:auth-errors": "node scripts/check-auth-error-classification.mjs && node scripts/check-auth-error-classification.mjs --fixture",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node scripts/migrate.mjs",
    "migrate:up": "node scripts/migrate.mjs up",
    "migrate:stamp": "node scripts/migrate.mjs stamp",
    "migrate:baseline": "node scripts/migrate.mjs baseline",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:check": "node scripts/check-drizzle-drift.mjs",
    "schema:equivalence": "node scripts/schema-equivalence.mjs",
    "catalog:write": "node scripts/catalog-fingerprint.mjs write",
    "catalog:check": "node scripts/catalog-fingerprint.mjs check",
    "queue:bootstrap": "node scripts/bootstrap-pgboss.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.1",
    "jose": "^6.2.17",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^9.18.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^18.8.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "js-yaml": "^5.5.0",
    "node-pg-migrate": "^7.9.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
